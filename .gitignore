# =========================================================
# Python and Jupyter
# =========================================================

__pycache__/
*.py[cod]
*.pyo
*.pyd

.ipynb_checkpoints/
*.ipynb_checkpoints

# =========================================================
# Virtual environments
# =========================================================

.venv/
venv/
env/
ENV/
*.env

# =========================================================
# Operating system files
# =========================================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
desktop.ini

# =========================================================
# IDE and editor files
# =========================================================

.vscode/
.idea/
*.swp
*.swo

# =========================================================
# Logs and temporary files
# =========================================================

*.log
*.tmp
*.temp
*.bak
*.old

# =========================================================
# Raw data and restricted data
# Do not push GISAID-derived raw data or feature archives
# unless sharing is explicitly permitted.
# =========================================================

data/Features_extracted/*
data/raw_archive/*
*.7z
*.7z.*
*.zip
*.tar
*.tar.gz
*.gz
*.rar

# Keep folder structure if .gitkeep files are added
!data/Features_extracted/.gitkeep
!data/raw_archive/.gitkeep

# =========================================================
# Large or sensitive generated analysis outputs
# These can usually be regenerated by running the notebook.
# =========================================================

outputs_revised/bootstrap/*
outputs_revised/checkpoints/*
outputs_revised/models/*

# Keep folder structure if .gitkeep files are added
!outputs_revised/bootstrap/.gitkeep
!outputs_revised/checkpoints/.gitkeep
!outputs_revised/models/.gitkeep

# =========================================================
# Model and prediction files
# These may be large or contain prediction-level outputs.
# =========================================================

*.joblib
*.pkl
*.pickle
*.npy
*.npz

# =========================================================
# Optional: temporary notebook exports
# =========================================================

*.html
*.pdf
*.docx

# =========================================================
# Keep important repository files
# =========================================================

!README.md
!SARS_CoV2_variant_classification_stability_analysis.ipynb